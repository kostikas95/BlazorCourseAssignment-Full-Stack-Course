<svg class="attendance-icon @StatusClass" viewBox="0 0 32 32" aria-hidden="true">
    <circle class="person-head" cx="13" cy="8" r="4" />
    <path class="person-body" d="M6 25v-5a7 7 0 0 1 14 0v5" />
    <circle class="status-badge" cx="24" cy="22" r="7" />
    @if (Status == AttendanceStatus.Attending)
    {
        <path class="status-mark" d="m20.5 22 2.2 2.2 4.3-4.5" />
    }
    else if (Status == AttendanceStatus.NotAttending)
    {
        <path class="status-mark" d="m21.5 19.5 5 5m0-5-5 5" />
    }
    else
    {
        <path class="status-mark" d="M22.3 20a1.8 1.8 0 1 1 3.2 1.1c-.7.8-1.5 1-1.5 2.1m0 2v.1" />
    }
</svg>

@code {
    [Parameter]
    public AttendanceStatus Status { get; set; }

    private string StatusClass => Status switch
    {
        AttendanceStatus.Attending => "attending",
        AttendanceStatus.NotAttending => "not-attending",
        AttendanceStatus.MaybeAttending => "maybe-attending",
        _ => throw new ArgumentOutOfRangeException(nameof(Status), Status, null)
    };
}
